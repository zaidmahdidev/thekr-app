rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The readable profile of a user: name, email, place, app version.
    // Each signed-in user can read and write only their own.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'joinedAt', 'signInProvider',
          'platform', 'appVersion', 'latitude', 'longitude', 'city',
          'district', 'lastSyncAt'
        ]);
    }

    // The backup: one small JSON document per user.
    match /users/{uid}/backup/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'schemaVersion', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 920000;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
